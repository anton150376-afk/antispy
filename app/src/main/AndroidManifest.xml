<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 
        Разрешения для мониторинга шпионских функций
        
        Для работы анти-шпионского сканера используются 3 уровня обнаружения:
        1. ForegroundService типа microphone — прямой перехват audio-сессий 
        2. NotificationListenerService — перехват системных уведомлений о записи
        3. UsageStatsManager — аудит обращений к сенсору за период
     -->

    <!-- Разрешение для запуска foreground-сервиса с типом microphone -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    
    <!-- Предыдущее разрешение для совместимости с Android 13- (API 33) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    
    <!-- Разрешение для запуска foreground-service camera (для камеры в будущем) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    
    <!-- Разрешение REQUEST_IGNORE_BATTERY_OPTIMIZATIONS — чтобы сервис не убивался энергосбережением -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Разрешение для UsageStatsManager — аудит обращений к сенсорам за период -->
    <!-- ⚠️ Этот permission НЕЛЬЗЯ получить через requestPermissions! 
         Пользователь должен включить его вручную: Settings → Security → Usage Access -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" 
                     tools:ignore="ProtectedPermissions" />

    <!-- Разрешение для записи аудио для сравнения с фоновыми процессами -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Разрешение для отправки push-уведомлений (опционально) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Разрешение для мониторинга закрывающихся приложений (для автозапуска блокировки) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Разрешение для чтения установленных пакетов -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" 
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Разрешение для мониторинга аудио-сессий -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:name=".AntSpyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AntiSpy"
        tools:targetApi="35">

        <!-- Главное приложение — Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AntiSpy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 
            ForegroundService для мониторинга микрофона.
            Этот сервис ловит audio-сессии в реальном времени — то, что нужно для ответа на вопрос 
            «какие приложения слушают микрофон прямо сейчас».
         -->
        <service
            android:name=".service.MicMonitoringService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- TODO: Добавить NotificationListenerService для перехвата уведомлений о записи (roadmap) -->

    </application>

</manifest>
